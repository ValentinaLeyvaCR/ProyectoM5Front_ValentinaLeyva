# Firebase client configuration. These values identify the Firebase project;
# authorization is enforced by Firebase Security Rules, not by hiding these keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Vercel Function variables. Never prefix these with VITE_.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=

# Restrict CORS to the deployed app origin in production.
APP_ORIGIN=
